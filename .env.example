# Public base URL of the deployed site (no trailing slash).
# Used for canonical URLs, hreflang alternates, sitemap.xml, robots.txt and
# the Open Graph card.
#
# Optional on Vercel: the build falls back to VERCEL_PROJECT_PRODUCTION_URL,
# which Vercel injects automatically. Set this once you have a custom domain.
NEXT_PUBLIC_SITE_URL=https://YOUR-DOMAIN
